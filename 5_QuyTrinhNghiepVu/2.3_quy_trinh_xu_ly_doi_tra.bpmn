      <bpmn:outgoing>Flow_8_EndF</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Event_Fail_7x" name="Bác bỏ khiếu nại (Gian lận)">
      <bpmn:incoming>Flow_8_EndF</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Act_QC_8v" name="Dán nhãn Restock &#38; Đưa lên kệ">
