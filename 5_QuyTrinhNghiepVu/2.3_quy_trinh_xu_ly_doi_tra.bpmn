    <bpmn:startEvent id="Start_8n4m2" name="Tạo yêu cầu hoàn trả trên App">
      <bpmn:outgoing>Flow_1_7n3</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Act_Sys_1q" name="Tiếp nhận &#38; Tự động sinh mã RMA">
