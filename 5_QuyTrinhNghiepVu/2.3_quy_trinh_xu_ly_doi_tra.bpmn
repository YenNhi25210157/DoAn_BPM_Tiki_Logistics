      <bpmn:incoming>Flow_10_Upd</bpmn:incoming>
      <bpmn:outgoing>Flow_11_Fin</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Act_Fin_6t" name="Xác nhận lỗi &#38; Chuyển lệnh Hoàn tiền (Refund)">
      <bpmn:incoming>Flow_11_Fin</bpmn:incoming>
      <bpmn:outgoing>Flow_12_EndS</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Succ_2y" name="Hoàn tiền &#38; Đóng mã RMA">
