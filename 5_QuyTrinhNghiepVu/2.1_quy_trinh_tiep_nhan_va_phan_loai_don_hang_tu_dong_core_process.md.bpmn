          <dc:Bounds x="416" y="228" width="68" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Refuse_di" bpmnElement="Task_Refuse">
        <dc:Bounds x="560" y="270" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Scan_PDA_di" bpmnElement="Task_Scan_PDA">
        <dc:Bounds x="560" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Barcode_di" bpmnElement="Gateway_Barcode" isMarkerVisible="true">
        <dc:Bounds x="710" y="173" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="695" y="130" width="81" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Conveyor_Main_di" bpmnElement="Task_Conveyor_Main">
        <dc:Bounds x="840" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DWS_Measure_di" bpmnElement="Task_DWS_Measure">
        <dc:Bounds x="990" y="540" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Oversize_di" bpmnElement="Gateway_Oversize" isMarkerVisible="true">
        <dc:Bounds x="1140" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1121" y="500" width="89" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Oversize_Bypass_di" bpmnElement="Task_Oversize_Bypass">
