    </bpmn:laneSet>
    <bpmn:startEvent id="Start_8f3a" name="Gửi khiếu nại (Mất hàng, trễ...)">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Act_2b9c" name="Tự động phân loại &#38; Sinh mã CS Ticket">
