      <bpmn:outgoing>Flow_4_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_6_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Act_1c8e" name="Phản hồi trực tiếp, giải đáp thông tin">
