<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_lastmile_delivery" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <bpmn:collaboration id="Collaboration_lastmile_delivery">
    <bpmn:participant id="Participant_lastmile" name="Bưu cục chặng cuối / Trạm giao nhận (Last-mile Hub / Delivery Station) Tiki Logistics" processRef="Process_lastmile" />
  </bpmn:collaboration>
  <bpmn:process id="Process_lastmile" isExecutable="false">
    <bpmn:laneSet id="LaneSet_lastmile">
      <bpmn:lane id="Lane_tms_rider_app" name="Hệ thống TMS &#38; Ứng dụng Tài xế (TMS &#38; Rider App)">
        <bpmn:flowNodeRef>Task_Out_for_Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_COD_Required</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Set_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success_Delivered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RTS_or_Reschedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Failed_Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Webhook_Success</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rider" name="Nhân viên Giao hàng (Tài xế / Rider)">
        <bpmn:flowNodeRef>Start_Shift</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scan_to_Van</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Manifest_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Report_Discrepancy</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Move_and_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Customer_Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Call_Limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Requeue_Call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Handover_Package</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Co_Check_Allowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_COD_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Payment_Method</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Cash_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Signature_and_Photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Return_to_Hub</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Handover_to_Dispatcher</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reschedule_Delivery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Set_Delivery_Failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Refuse_Manifest</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_customer" name="Người mua hàng (Buyer / Customer)">
        <bpmn:flowNodeRef>Gateway_Customer_Ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Customer_Co_Check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Goods_Intact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Customer_Refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Scan_QR</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:task id="Task_Out_for_Delivery" name="Task 1.3: Cập nhật trạng thái &#39;Đang giao&#39; và gửi thông báo dự kiến giao hàng cho Khách">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_COD_Required" name="XOR 7: Đơn hàng có yêu cầu thu hộ tiền (Thanh toán COD) không?">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Set_Delivered" name="Task 4.5: Cập nhật trạng thái &#39;Giao hàng thành công&#39; &#38; gửi hóa đơn điện tử">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Success_Delivered" name="End Event 1 (Thành công): Đơn hàng hoàn tất vòng đời giao nhận">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_RTS_or_Reschedule" name="Task 5.3: Phân loại: Chờ giao lại ca sau hoặc Hoàn trả người bán">
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Failed_Delivery" name="End Event 2 (Thất bại / Chờ xử lý): Kết thúc chuyến giao không thành công">
      <bpmn:incoming>Flow_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="Start_Shift" name="Rider bắt đầu ca, nhận danh sách chuyến giao (Run-sheet) phân bổ">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Scan_to_Van" name="Task 1.1: Quét mã vạch (Barcode/QR) trên kiện hàng đưa lên xe">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Manifest_Match" name="XOR 1: Mã kiện hàng và số lượng vật lý có khớp với Manifest?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Report_Discrepancy" name="Task 1.2: Báo cáo Điều phối viên Bưu cục xử lý lệch tồn">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Move_and_Call" name="Task 2.1: Di chuyển theo lộ trình tối ưu và gọi điện cho Người mua">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Customer_Answer" name="XOR 2: Người mua hàng có bắt máy nghe điện thoại không?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Call_Limit" name="XOR 3: Đã vượt quá số lần gọi tối đa cho phép (3 lần)?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Requeue_Call" name="Task 2.2: Ghi nhận tạm thời không liên lạc được, đẩy xuống cuối danh sách">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Handover_Package" name="Task 3.1: Gặp gỡ và bàn giao kiện hàng cho Người mua hàng">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Co_Check_Allowed" name="XOR 5: Kiện hàng này có nhãn &#39;Cho phép đồng kiểm&#39; không?">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_COD_Request" name="Task 4.1: Yêu cầu Người mua hàng thanh toán số tiền COD hiển thị">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Payment_Method" name="XOR 8: Người mua hàng chọn hình thức thanh toán trực tuyến thay vì Tiền mặt?">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Cash_Payment" name="Task 4.2: Nhận tiền mặt, kiểm đếm và xác nhận thu đủ">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Signature_and_Photo" name="Task 4.4: Yêu cầu Người mua hàng ký điện tử e-POD &#38; Chụp ảnh kiện hàng">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Return_to_Hub" name="Task 5.1: Cuối ca làm việc, mang các kiện hàng giao thất bại về bưu cục">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Handover_to_Dispatcher" name="Task 5.2: Bàn giao vật lý kiện hàng cho kho, quét mã cập nhật lưu kho">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Customer_Ready" name="XOR 4: Người mua hàng có sẵn sàng nhận hàng tại thời điểm này không?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Customer_Co_Check" name="Task 3.2: Mở hộp kiểm tra tình trạng hàng hóa dưới sự chứng kiến của Rider">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Goods_Intact" name="XOR 6: Tình trạng hàng hóa bên trong có đúng yêu cầu và nguyên vẹn không?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Customer_Refuse" name="Task 3.3: Từ chối nhận hàng (Vỡ hỏng/Sai hàng)">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Scan_QR" name="Task 4.3: Dùng ứng dụng ngân hàng quét mã QR động được tạo từ App Rider">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Shift" targetRef="Task_Scan_to_Van" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Scan_to_Van" targetRef="Gateway_Manifest_Match" />
    <bpmn:sequenceFlow id="Flow_3" name="KHÔNG (Thừa/Thiếu/Sai)" sourceRef="Gateway_Manifest_Match" targetRef="Task_Report_Discrepancy" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Report_Discrepancy" targetRef="Task_Scan_to_Van" />
    <bpmn:sequenceFlow id="Flow_5" name="CÓ (Khớp 100%)" sourceRef="Gateway_Manifest_Match" targetRef="Task_Out_for_Delivery" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Out_for_Delivery" targetRef="Task_Move_and_Call" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_Move_and_Call" targetRef="Gateway_Customer_Answer" />
    <bpmn:sequenceFlow id="Flow_8" name="KHÔNG (Không nghe)" sourceRef="Gateway_Customer_Answer" targetRef="Gateway_Call_Limit" />
    <bpmn:sequenceFlow id="Flow_9" name="KHÔNG (Chưa quá 3 lần)" sourceRef="Gateway_Call_Limit" targetRef="Task_Requeue_Call" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Requeue_Call" targetRef="Task_Move_and_Call" />
    <bpmn:sequenceFlow id="Flow_11" name="CÓ (Đã quá 3 lần)" sourceRef="Gateway_Call_Limit" targetRef="Task_Set_Delivery_Failed" />
    <bpmn:sequenceFlow id="Flow_12" name="CÓ (Bắt máy)" sourceRef="Gateway_Customer_Answer" targetRef="Gateway_Customer_Ready" />
    <bpmn:sequenceFlow id="Flow_13" name="KHÔNG (Hẹn lại)" sourceRef="Gateway_Customer_Ready" targetRef="Task_Reschedule_Delivery" />
    <bpmn:sequenceFlow id="Flow_14" name="CÓ (Sẵn sàng)" sourceRef="Gateway_Customer_Ready" targetRef="Task_Handover_Package" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_Handover_Package" targetRef="Gateway_Co_Check_Allowed" />
    <bpmn:sequenceFlow id="Flow_16" name="KHÔNG" sourceRef="Gateway_Co_Check_Allowed" targetRef="Gateway_COD_Required" />
    <bpmn:sequenceFlow id="Flow_17" name="CÓ" sourceRef="Gateway_Co_Check_Allowed" targetRef="Task_Customer_Co_Check" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Task_Customer_Co_Check" targetRef="Gateway_Goods_Intact" />
    <bpmn:sequenceFlow id="Flow_19" name="KHÔNG (Lỗi/Hỏng)" sourceRef="Gateway_Goods_Intact" targetRef="Task_Customer_Refuse" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Task_Customer_Refuse" targetRef="Task_Refuse_Manifest" />
    <bpmn:sequenceFlow id="Flow_21" name="CÓ (Nguyên vẹn)" sourceRef="Gateway_Goods_Intact" targetRef="Gateway_COD_Required" />
    <bpmn:sequenceFlow id="Flow_22" name="KHÔNG" sourceRef="Gateway_COD_Required" targetRef="Task_Signature_and_Photo" />
    <bpmn:sequenceFlow id="Flow_23" name="CÓ" sourceRef="Gateway_COD_Required" targetRef="Task_COD_Request" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_COD_Request" targetRef="Gateway_Payment_Method" />
    <bpmn:sequenceFlow id="Flow_25" name="KHÔNG (Tiền mặt)" sourceRef="Gateway_Payment_Method" targetRef="Task_Cash_Payment" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Cash_Payment" targetRef="Task_Signature_and_Photo" />
    <bpmn:sequenceFlow id="Flow_27" name="CÓ (Online)" sourceRef="Gateway_Payment_Method" targetRef="Task_Scan_QR" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Task_Scan_QR" targetRef="Gateway_Webhook_Success" />
    <bpmn:sequenceFlow id="Flow_29" name="KHÔNG (Lỗi/Retry)" sourceRef="Gateway_Webhook_Success" targetRef="Gateway_Payment_Method" />
    <bpmn:sequenceFlow id="Flow_30" name="CÓ (Thành công)" sourceRef="Gateway_Webhook_Success" targetRef="Task_Signature_and_Photo" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Signature_and_Photo" targetRef="Task_Set_Delivered" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Task_Set_Delivered" targetRef="End_Success_Delivered" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Task_Set_Delivery_Failed" targetRef="Task_Return_to_Hub" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_Reschedule_Delivery" targetRef="Task_Return_to_Hub" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Task_Refuse_Manifest" targetRef="Task_Return_to_Hub" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Task_Return_to_Hub" targetRef="Task_Handover_to_Dispatcher" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Task_Handover_to_Dispatcher" targetRef="Task_RTS_or_Reschedule" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Task_RTS_or_Reschedule" targetRef="End_Failed_Delivery" />
    <bpmn:task id="Task_Reschedule_Delivery" name="Task 2.4: Ghi nhận lý do và cập nhật Lịch hẹn giao lại (Reschedule)">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Set_Delivery_Failed" name="Task 2.3: Thao tác cập nhật trạng thái &#39;Giao không thành công do không liên lạc được&#39;">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Refuse_Manifest" name="Task 3.4: Lập biên bản đồng kiểm, cập nhật trạng thái &#39;Khách từ chối do lỗi&#39;">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Webhook_Success" name="XOR 9: Hệ thống TMS có nhận được Webhook báo giao dịch thành công?">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_lastmile_delivery">
      <bpmndi:BPMNShape id="Participant_lastmile_di" bpmnElement="Participant_lastmile" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2850" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_customer_di" bpmnElement="Lane_customer" isHorizontal="true">
        <dc:Bounds x="180" y="880" width="2820" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_rider_di" bpmnElement="Lane_rider" isHorizontal="true">
        <dc:Bounds x="180" y="480" width="2820" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_tms_rider_app_di" bpmnElement="Lane_tms_rider_app" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="2820" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Out_for_Delivery_di" bpmnElement="Task_Out_for_Delivery">
        <dc:Bounds x="580" y="158" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_COD_Required_di" bpmnElement="Gateway_COD_Required" isMarkerVisible="true">
        <dc:Bounds x="1610" y="173" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1591" y="228" width="88" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Set_Delivered_di" bpmnElement="Task_Set_Delivered">
        <dc:Bounds x="2110" y="158" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Success_Delivered_di" bpmnElement="End_Success_Delivered">
        <dc:Bounds x="2270" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2250" y="221" width="76" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RTS_or_Reschedule_di" bpmnElement="Task_RTS_or_Reschedule">
        <dc:Bounds x="2540" y="158" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Failed_Delivery_di" bpmnElement="End_Failed_Delivery">
        <dc:Bounds x="2700" y="180" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2680" y="221" width="76" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Shift_di" bpmnElement="Start_Shift">
        <dc:Bounds x="222" y="580" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="215" y="634" width="90" height="53" />
