<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_accounting_cod" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.22.0">
  <bpmn:collaboration id="Collaboration_accounting_cod">
    <bpmn:participant id="Participant_accounting" name="Phòng Kế toán &#38; Vận hành Bưu cục Tiki Logistics" processRef="Process_accounting" />
  </bpmn:collaboration>
  <bpmn:process id="Process_accounting" isExecutable="false">
    <bpmn:laneSet id="LaneSet_accounting">
      <bpmn:lane id="Lane_rider" name="Nhân viên Giao hàng (Tài xế / Rider)">
        <bpmn:flowNodeRef>Task_Handover_Cash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Shift_End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_cashier" name="Thủ quỹ Bưu cục (Hub Cashier)">
        <bpmn:flowNodeRef>Gateway_Cash_Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Difference_Type</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Negative_Debt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Surplus_Cash</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Confirm_Received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deposit_to_Bank</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Verify_Cash</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_erp_hq" name="Hệ thống Kế toán ERP &#38; Kế toán Hội sở (ERP System &#38; HQ Accountant)">
        <bpmn:flowNodeRef>Task_ERP_Get_Statement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Bank_Recon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Flag_Investigation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Stop_Recon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Lock_Hub_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Map_Order_ID</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Price_Changed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Deduct_Fees</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Dispute_Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Add_to_Seller_Recon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compile_Payout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Balance_Positive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Offset_Debt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Offset_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Chief_Approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Reject_Payout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Send_ePayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Payment_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Mark_Error</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Clear_AP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Success_Payout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Hold_COD</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="Gateway_Cash_Match" name="XOR 1: Số tiền mặt thực tế có khớp hoàn toàn với Bảng kê?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Difference_Type" name="XOR 2: Số tiền đang bị THIẾU hay THỪA so với hệ thống?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Negative_Debt" name="Task 1.3: Yêu cầu nộp bù / Lập &#39;Phiếu ghi nhận công nợ âm&#39; trừ lương">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Surplus_Cash" name="Task 1.4: Lập &#39;Biên bản tiền thừa&#39; treo tài khoản tạm giữ chờ rà soát">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Confirm_Received" name="Task 1.5: Bấm xác nhận &#39;Đã thu tiền&#39; trên hệ thống. Đóng ca Tài xế">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Deposit_to_Bank" name="Task 2.1: Lập lệnh nộp toàn bộ quỹ tiền mặt vào tài khoản Ngân hàng cuối ngày">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_ERP_Get_Statement" name="Task 2.2: Gửi API truy vấn sao kê (Bank Statement) lấy dữ liệu tiền vào">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Bank_Recon" name="XOR 3: Số tiền Ngân hàng ghi nhận có khớp Báo cáo chốt quỹ?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Flag_Investigation" name="Task 2.3: Cảnh báo đỏ (Flag), yêu cầu lập biên bản điều tra">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Stop_Recon" name="End Event 1 (Tạm ngưng): Dừng đối soát cụm dữ liệu Bưu cục này">
      <bpmn:incoming>Flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_Lock_Hub_Data" name="Task 2.4: Khóa sổ (Lock Data) dữ liệu thu hộ của Bưu cục trong ngày">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Map_Order_ID" name="Task 3.1: Tự động map dòng tiền COD tổng vừa nhận với từng Order ID cụ thể">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Price_Changed" name="XOR 4: Đơn hàng có phát sinh thay đổi giá trị thực thu?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Deduct_Fees" name="Task 3.2: Tính toán và cấn trừ lại Phí vận chuyển, Phí dịch vụ">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Dispute_Pending" name="XOR 5: Đơn hàng có đang nằm trong trạng thái &#39;Bị khiếu nại&#39; không?">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Add_to_Seller_Recon" name="Task 3.4: Đưa giá trị COD thuần vào Bảng đối soát công nợ Nhà bán">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Compile_Payout" name="Task 4.1: Tới kỳ thanh toán, tổng hợp &#39;Bảng kê thanh toán COD&#39; (Payout Statement)">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Balance_Positive" name="XOR 6: Tổng dư nợ cuối cùng (COD - Cước - Phí) có LỚN HƠN 0 không?">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Offset_Debt" name="Task 4.2: Thực hiện cấn trừ công nợ, gửi Email thông báo (Không chuyển tiền)">
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Offset_Done" name="End Event 2 (Hoàn tất Cấn trừ): Quy trình đối soát xong">
      <bpmn:incoming>Flow_26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Chief_Approve" name="XOR 7: Kế toán trưởng có bấm Phê duyệt (Approve) lệnh chi?">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Reject_Payout" name="Task 4.3: Hủy lệnh chi, trả về yêu cầu hệ thống tính toán lại">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Send_ePayment" name="Task 4.4: Đẩy lệnh chi điện tử sang Ngân hàng chuyển khoản">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_Payment_Success" name="XOR 8: API Ngân hàng trả về kết quả Giao dịch thành công?">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_Mark_Error" name="Task 4.5: Đánh dấu &#39;Giao dịch lỗi&#39;, yêu cầu Nhà bán cập nhật tài khoản">
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_Clear_AP" name="Task 4.6: Chốt công nợ (Cleared), xuất gửi Ủy nhiệm chi điện tử">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Success_Payout" name="End Event 3 (Thành công): Quy trình thanh toán COD hoàn tất viên mãn">
      <bpmn:incoming>Flow_34</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_Shift_End" targetRef="Task_Handover_Cash" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Handover_Cash" targetRef="Task_Verify_Cash" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Verify_Cash" targetRef="Gateway_Cash_Match" />
    <bpmn:sequenceFlow id="Flow_4" name="KHÔNG (Lệch số)" sourceRef="Gateway_Cash_Match" targetRef="Gateway_Difference_Type" />
    <bpmn:sequenceFlow id="Flow_5" name="THIẾU" sourceRef="Gateway_Difference_Type" targetRef="Task_Negative_Debt" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Negative_Debt" targetRef="Task_Confirm_Received" />
    <bpmn:sequenceFlow id="Flow_7" name="THỪA" sourceRef="Gateway_Difference_Type" targetRef="Task_Surplus_Cash" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Surplus_Cash" targetRef="Task_Confirm_Received" />
    <bpmn:sequenceFlow id="Flow_9" name="CÓ (Khớp số liệu)" sourceRef="Gateway_Cash_Match" targetRef="Task_Confirm_Received" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_Confirm_Received" targetRef="Task_Deposit_to_Bank" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Deposit_to_Bank" targetRef="Task_ERP_Get_Statement" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_ERP_Get_Statement" targetRef="Gateway_Bank_Recon" />
    <bpmn:sequenceFlow id="Flow_13" name="KHÔNG" sourceRef="Gateway_Bank_Recon" targetRef="Task_Flag_Investigation" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Task_Flag_Investigation" targetRef="End_Stop_Recon" />
    <bpmn:sequenceFlow id="Flow_15" name="CÓ" sourceRef="Gateway_Bank_Recon" targetRef="Task_Lock_Hub_Data" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Lock_Hub_Data" targetRef="Task_Map_Order_ID" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Map_Order_ID" targetRef="Gateway_Price_Changed" />
    <bpmn:sequenceFlow id="Flow_18" name="CÓ" sourceRef="Gateway_Price_Changed" targetRef="Task_Deduct_Fees" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_Deduct_Fees" targetRef="Gateway_Dispute_Pending" />
    <bpmn:sequenceFlow id="Flow_20" name="KHÔNG" sourceRef="Gateway_Price_Changed" targetRef="Gateway_Dispute_Pending" />
    <bpmn:sequenceFlow id="Flow_21" name="CÓ" sourceRef="Gateway_Dispute_Pending" targetRef="Task_Hold_COD" />
    <bpmn:sequenceFlow id="Flow_22" name="KHÔNG" sourceRef="Gateway_Dispute_Pending" targetRef="Task_Add_to_Seller_Recon" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_Add_to_Seller_Recon" targetRef="Task_Compile_Payout" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Task_Compile_Payout" targetRef="Gateway_Balance_Positive" />
    <bpmn:sequenceFlow id="Flow_25" name="KHÔNG" sourceRef="Gateway_Balance_Positive" targetRef="Task_Offset_Debt" />
    <bpmn:sequenceFlow id="Flow_26" sourceRef="Task_Offset_Debt" targetRef="End_Offset_Done" />
    <bpmn:sequenceFlow id="Flow_27" name="CÓ" sourceRef="Gateway_Balance_Positive" targetRef="Gateway_Chief_Approve" />
    <bpmn:sequenceFlow id="Flow_28" name="KHÔNG (Từ chối)" sourceRef="Gateway_Chief_Approve" targetRef="Task_Reject_Payout" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Task_Reject_Payout" targetRef="Task_Compile_Payout" />
    <bpmn:sequenceFlow id="Flow_30" name="CÓ (Duyệt)" sourceRef="Gateway_Chief_Approve" targetRef="Task_Send_ePayment" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Task_Send_ePayment" targetRef="Gateway_Payment_Success" />
    <bpmn:sequenceFlow id="Flow_32" name="KHÔNG" sourceRef="Gateway_Payment_Success" targetRef="Task_Mark_Error" />
    <bpmn:sequenceFlow id="Flow_33" name="CÓ" sourceRef="Gateway_Payment_Success" targetRef="Task_Clear_AP" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Task_Clear_AP" targetRef="End_Success_Payout" />
    <bpmn:task id="Task_Handover_Cash" name="Task 1.1: Bàn giao số tiền mặt thu hộ (COD) thực tế cho Thủ quỹ Bưu cục">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="Start_Shift_End" name="Rider kết thúc ca chạy, tạo &#39;Bảng kê chốt ca&#39; trên App">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_Verify_Cash" name="Task 1.2: Kiểm đếm tiền mặt qua máy đếm và đối chiếu với hệ thống TMS">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_Hold_COD" name="Task 3.3: Khoanh vùng số tiền (Hold COD), tạm thời đóng băng">
      <bpmn:incoming>Flow_21</bpmn:incoming>
    </bpmn:task>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_accounting_cod">
      <bpmndi:BPMNShape id="Participant_accounting_di" bpmnElement="Participant_accounting" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="2850" height="1200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_erp_hq_di" bpmnElement="Lane_erp_hq" isHorizontal="true">
        <dc:Bounds x="180" y="780" width="2820" height="500" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_cashier_di" bpmnElement="Lane_cashier" isHorizontal="true">
        <dc:Bounds x="180" y="380" width="2820" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_rider_di" bpmnElement="Lane_rider" isHorizontal="true">
        <dc:Bounds x="180" y="80" width="2820" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Cash_Match_di" bpmnElement="Gateway_Cash_Match" isMarkerVisible="true">
        <dc:Bounds x="460" y="473" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="446" y="409.5" width="77" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Difference_Type_di" bpmnElement="Gateway_Difference_Type" isMarkerVisible="true">
        <dc:Bounds x="460" y="595" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="397" y="633" width="86" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Negative_Debt_di" bpmnElement="Task_Negative_Debt">
        <dc:Bounds x="560" y="580" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Surplus_Cash_di" bpmnElement="Task_Surplus_Cash">
        <dc:Bounds x="560" y="690" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Confirm_Received_di" bpmnElement="Task_Confirm_Received">
        <dc:Bounds x="710" y="458" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Deposit_to_Bank_di" bpmnElement="Task_Deposit_to_Bank">
        <dc:Bounds x="860" y="458" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ERP_Get_Statement_di" bpmnElement="Task_ERP_Get_Statement">
        <dc:Bounds x="860" y="878" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Bank_Recon_di" bpmnElement="Gateway_Bank_Recon" isMarkerVisible="true">
        <dc:Bounds x="1010" y="893" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="990" y="833" width="90" height="53" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Flag_Investigation_di" bpmnElement="Task_Flag_Investigation">
        <dc:Bounds x="1010" y="1010" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Stop_Recon_di" bpmnElement="End_Stop_Recon">
        <dc:Bounds x="1160" y="1032" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1140" y="1073" width="76" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Lock_Hub_Data_di" bpmnElement="Task_Lock_Hub_Data">
        <dc:Bounds x="1160" y="878" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Map_Order_ID_di" bpmnElement="Task_Map_Order_ID">
        <dc:Bounds x="1310" y="878" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Price_Changed_di" bpmnElement="Gateway_Price_Changed" isMarkerVisible="true">
        <dc:Bounds x="1460" y="893" width="50" height="50" />
